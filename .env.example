# Local development (`bun run dev`) against the `db` service of compose.yaml.
# If host port 5432 is taken, set DB_PORT and use it in DATABASE_URL too.
# DB_PORT=5432
DATABASE_URL=postgresql://wise_wizard:wise_wizard@localhost:5432/wise_wizard

# Claude subscription token for the Agent SDK, from `claude setup-token`.
# See docs/adr/0003-motor-de-ia-agent-sdk-con-suscripcion.md. Leave empty until the SDK is wired.
CLAUDE_CODE_OAUTH_TOKEN=
