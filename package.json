{
  "name": "wise-wizard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build && cp -R .next/static .next/standalone/.next/",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run typecheck && bun run format:check && bun run test && fallow && react-doctor --no-telemetry --no-supply-chain --blocking warning && IMPECCABLE_NO_TELEMETRY=1 impeccable detect src",
    "setup": "graphify hook install && claude plugin install ponytail@ponytail --scope project && claude plugin install impeccable@impeccable --scope project && claude plugin install mattpocock-skills@claude-plugins-official --scope project"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "^1.3.0",
    "@dcc/ui": "github:DCC-FCFM-UCHILE/dcc-ui-kit#v2.8.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "fallow": "3.38.1",
    "impeccable": "4.8.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "react-doctor": "0.9.18",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [],
  "engines": {
    "node": "26.x"
  }
}
